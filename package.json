{
  "name": "lexa-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --import ./tests/register.mjs \"lib/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --import ./tests/register.mjs \"tests/integration/*.integration.ts\"",
    "email:templates": "node --import ./tests/register.mjs scripts/supabase-email-templates.ts",
    "email:verify": "node --env-file-if-exists=.env.local --import ./tests/register.mjs scripts/verify-smtp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.24.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
