# Mesa — variáveis de ambiente. Copie para .env.local e preencha. Nada aqui vai para o navegador.

# ——— Acesso (obrigatório) ————————————————————————————————————————————————
# Segredo que assina o cookie de sessão. Pelo menos 32 caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar este valor encerra todas as sessões abertas.
DESK_SESSION_SECRET=
# Senha de acesso. Prefira DESK_PASSWORD_HASH (gerado com `npm run auth:hash -- "sua senha"`);
# se as duas estiverem definidas, vale o hash.
DESK_PASSWORD=
DESK_PASSWORD_HASH=

# ——— Banco de dados ———————————————————————————————————————————————————————
# PostgreSQL (local, Supabase, Neon…). Ex.: postgres://usuario:senha@localhost:5432/mesa
# No Supabase, use a "connection string" do Postgres (Session pooler), com a senha do banco.
DATABASE_URL=
# Conexões simultâneas do pool (padrão 5).
DATABASE_POOL_MAX=
# Sem DATABASE_URL, a Mesa usa um PostgreSQL embutido (PGlite) gravado nesta pasta
# (padrão: .data/pglite). Em produção isso só é permitido com DESK_ALLOW_EMBEDDED_DB=true.
DESK_DATA_DIR=
DESK_ALLOW_EMBEDDED_DB=
# As migrações rodam sozinhas na primeira conexão. Use false para aplicá-las só com `npm run db:migrate`.
DESK_AUTO_MIGRATE=

# ——— Preferências ————————————————————————————————————————————————————————
# Fuso usado até o navegador informar o dele (e se não houver um fixado em Configurações).
DESK_DEFAULT_TIMEZONE=America/Sao_Paulo
