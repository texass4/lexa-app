# Copie este arquivo para `.env.local` — o Next não lê `.env.example`.

# --- Supabase (Settings › API do projeto) -----------------------------------
# URL e chave pública (anon/publishable): vão para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: ignora a RLS. SÓ no servidor — nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Super Admin (administrador da Íntegra) -------------------------------------
# Criado no start do servidor se ainda não existir. A senha só vale na criação;
# depois, troque pela tela "Esqueci minha senha".
LEXA_SUPERADMIN_EMAIL=
LEXA_SUPERADMIN_PASSWORD=

# Opcional: endereço público do app, usado nos links de convite e recuperação.
# Sem ele, usa o endereço da própria requisição.
# NEXT_PUBLIC_SITE_URL=https://app.lexa.com.br

# --- Integrações futuras (Íntegra Admin) -----------------------------------------
# O Admin mostra só se estas chaves existem, nunca o valor. Com um gateway
# configurado, o Financeiro deixa de ser "estimado" (o webhook grava em `payments`).
# STRIPE_SECRET_KEY=
# MERCADOPAGO_ACCESS_TOKEN=

# --- Consulta de processos ---------------------------------------------------
# Chave da API pública de dados processuais do CNJ (DataJud), usada só pelo
# servidor (`lib/integrations/legal/datajud/provider.ts`). A chave abaixo é a
# pública divulgada pelo CNJ. Nunca use o prefixo NEXT_PUBLIC_.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Opcional: prazo máximo de uma consulta, somando tentativas (padrão: 60000 = 60 s).
# PROCESS_LOOKUP_TIMEOUT_MS=60000
# Opcional: outro endereço para a API (proxy corporativo, homologação).
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# --- Monitoramento automático de processos --------------------------------------
# O agendador da hospedagem chama GET /api/cron/process-sync (sugestão: a cada hora)
# com o cabeçalho `Authorization: Bearer <CRON_SECRET>` — o Vercel Cron envia assim
# quando esta variável existe. Sem ela (ou com menos de 16 caracteres), a rota não
# roda para ninguém. Gere um valor longo e aleatório. SÓ no servidor.
CRON_SECRET=
# Opcionais — ritmo de cada execução (limites seguros em lib/services/processes/monitoring-policy.ts).
# Processos por execução (padrão 20, máx. 100):
# PROCESS_SYNC_BATCH_SIZE=20
# Consultas simultâneas (padrão 2, máx. 3):
# PROCESS_SYNC_CONCURRENCY=2
# Pausa entre idas à fonte, em ms (padrão 1000):
# PROCESS_SYNC_PAUSE_MS=1000
# Depois deste tempo, a execução não começa novas consultas, em ms (padrão 120000):
# PROCESS_SYNC_TIME_BUDGET_MS=120000

# --- Íntegra IA (Gemini) ---------------------------------------------------------
# Chave da Gemini API (https://aistudio.google.com/apikey). SÓ no servidor:
# nunca use o prefixo NEXT_PUBLIC_ e nunca commite a chave. Sem ela, a Íntegra IA
# aparece como "não configurada" — não há resposta simulada.
GEMINI_API_KEY=
# Modelo Flash usado em todas as análises (padrão: gemini-2.5-flash). Use um nome
# que apareça em https://generativelanguage.googleapis.com/v1beta/models?key=SUA_CHAVE
GEMINI_MODEL=
# Opcional: modelo(s) reserva, separados por vírgula, usados quando o principal está
# sobrecarregado (503), sem cota (429) ou indisponível (404).
GEMINI_FALLBACK_MODEL=
# false desliga a Íntegra IA sem remover código (a interface mostra "indisponível").
AI_ENABLED=true
# Opcional: tempo máximo de cada chamada ao modelo, em ms (padrão: 45000).
# AI_TIMEOUT_MS=45000

# --- WhatsApp (Z-API) — Central de Atendimento ----------------------------------
# Tudo só no servidor: nunca use o prefixo NEXT_PUBLIC_ nem commite os valores.
# Painel da Z-API › Instâncias (ID e token) e › Segurança (token da conta).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Escritório (organizations.id) dono deste número. É o servidor quem vincula a
# instância ao escritório — nenhuma tela consegue apontá-la para outro.
ZAPI_ORGANIZATION_ID=
# Segredo da URL do webhook (a Z-API não assina os eventos). Gere um valor longo e
# aleatório, ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ZAPI_WEBHOOK_SECRET=
# Endereço público HTTPS da Íntegra para montar a URL do webhook (a Z-API recusa http).
# Sem ele, usa NEXT_PUBLIC_SITE_URL ou o endereço da requisição.
# ZAPI_WEBHOOK_BASE_URL=https://app.lexa.com.br

# --- Íntegra IA (Claude) --------------------------------------------------------------
# Resumos, sugestões de resposta e tarefas na Central. Só no servidor.
# ANTHROPIC_API_KEY=
