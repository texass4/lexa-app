# Copie este arquivo para `.env.local` — o Next não lê `.env.example`.

# --- Supabase (Settings › API do projeto) -----------------------------------
# URL e chave pública (anon/publishable): vão para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: ignora a RLS. SÓ no servidor — nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Super Admin (administrador do LEXA) -------------------------------------
# Criado no start do servidor se ainda não existir. A senha só vale na criação;
# depois, troque pela tela "Esqueci minha senha".
LEXA_SUPERADMIN_EMAIL=
LEXA_SUPERADMIN_PASSWORD=

# Opcional: endereço público do app, usado nos links de convite e recuperação.
# Sem ele, usa o endereço da própria requisição.
# NEXT_PUBLIC_SITE_URL=https://app.lexa.com.br

# --- DataJud -----------------------------------------------------------------
# Chave da API pública do DataJud (CNJ), usada por `python/datajud.py`.
# A chave abaixo é a pública divulgada pelo CNJ. Fica só no servidor:
# nunca use o prefixo NEXT_PUBLIC_.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# Opcionais
# Executável do Python 3 com `requests` (padrão: `python` no Windows, `python3` nos demais).
# PYTHON_BIN=python
# Tempo máximo de uma consulta, somando todas as tentativas (padrão: 300000 = 5 min).
# DATAJUD_PYTHON_TIMEOUT_MS=300000

# --- LEXA IA (Gemini) ---------------------------------------------------------
# Chave da Gemini API (https://aistudio.google.com/apikey). SÓ no servidor:
# nunca use o prefixo NEXT_PUBLIC_ e nunca commite a chave. Sem ela, a LEXA IA
# aparece como "não configurada" — não há resposta simulada.
GEMINI_API_KEY=
# Modelo Flash usado em todas as análises (padrão: gemini-2.5-flash). Use um nome
# que apareça em https://generativelanguage.googleapis.com/v1beta/models?key=SUA_CHAVE
GEMINI_MODEL=
# Opcional: modelo(s) reserva, separados por vírgula, usados quando o principal está
# sobrecarregado (503), sem cota (429) ou indisponível (404).
GEMINI_FALLBACK_MODEL=
# false desliga a LEXA IA sem remover código (a interface mostra "indisponível").
AI_ENABLED=true
# Opcional: tempo máximo de cada chamada ao modelo, em ms (padrão: 45000).
# AI_TIMEOUT_MS=45000

# --- WhatsApp (Z-API) — Central de Atendimento ----------------------------------
# Tudo só no servidor: nunca use o prefixo NEXT_PUBLIC_ nem commite os valores.
# Painel da Z-API › Instâncias (ID e token) e › Segurança (token da conta).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Escritório (organizations.id) dono deste número. É o servidor quem vincula a
# instância ao escritório — nenhuma tela consegue apontá-la para outro.
ZAPI_ORGANIZATION_ID=
# Segredo da URL do webhook (a Z-API não assina os eventos). Gere um valor longo e
# aleatório, ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ZAPI_WEBHOOK_SECRET=
# Endereço público HTTPS do LEXA para montar a URL do webhook (a Z-API recusa http).
# Sem ele, usa NEXT_PUBLIC_SITE_URL ou o endereço da requisição.
# ZAPI_WEBHOOK_BASE_URL=https://app.lexa.com.br

# --- Lexa IA (Claude) --------------------------------------------------------------
# Resumos, sugestões de resposta e tarefas na Central. Só no servidor.
# ANTHROPIC_API_KEY=
